[Unit]
Description=SmartFarm ACK-driven Raspberry Pi Gateway
Wants=network-online.target time-sync.target systemd-time-wait-sync.service
After=network-online.target time-sync.target systemd-time-wait-sync.service

[Service]
Type=simple
User=smartfarm-gateway
Group=smartfarm-gateway
SupplementaryGroups=dialout
WorkingDirectory=/opt/smartfarm-gateway
EnvironmentFile=/etc/smartfarm-gateway/gateway.env
ExecStart=/opt/smartfarm-gateway/.venv/bin/python implementation/gateway/gateway_runtime.py --config /etc/smartfarm-gateway/devices.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smartfarm-gateway

[Install]
WantedBy=multi-user.target
