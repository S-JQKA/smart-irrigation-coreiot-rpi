          "scriptLang": "TBEL",
          "jsScript": "if (msgType == \"POST_TELEMETRY_REQUEST\") {\n    var valid = msg.pumpState == null || msg.pumpState == \"ON\" || msg.pumpState == \"OFF\";\n    if (!valid) {\n        delete msg.pumpState;\n        msg.dataQuality = \"INVALID_STATE\";\n    } else {\n        msg.dataQuality = \"OK\";\n    }\n    if (msg.lastAck == null) msg.lastAck = \"NONE\";\n    if (msg.safetyBlockReason == null) msg.safetyBlockReason = \"NONE\";\n}\nreturn {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "if (msgType == \"POST_TELEMETRY_REQUEST\") {\n    var valid = msg.pumpState == null || msg.pumpState == \"ON\" || msg.pumpState == \"OFF\";\n    if (!valid) {\n        msg.remove(\"pumpState\");\n        msg.dataQuality = \"INVALID_STATE\";\n    } else {\n        msg.dataQuality = \"OK\";\n    }\n    if (msg.lastAck == null) msg.lastAck = \"NONE\";\n    if (msg.safetyBlockReason == null) msg.safetyBlockReason = \"NONE\";\n}\nreturn {msg: msg, metadata: metadata, msgType: msgType};"
